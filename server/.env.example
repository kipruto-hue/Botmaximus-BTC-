# BOTMAXIMUS secrets and local overrides.
#
#   copy this file to .env and fill in the real values.
#
# `.env` is gitignored. This template is committed, so it must NEVER contain a
# real key. Any value here can also be supplied as a plain environment variable,
# which is the better option on a VPS -- a key in the process environment does
# not sit on disk.
#
# Every secret is loaded as a SecretStr: it renders as '**********' in logs,
# tracebacks and settings dumps, and the raw value is read only at the point of
# use. Nothing in this system prints a key.

# ---------------------------------------------------------------- venue
# Bybit API credentials. Create the key with the NARROWEST permissions that
# work: read + derivatives trade. Do NOT enable withdrawal on a key a program
# holds -- no part of this system ever needs it, and a key that cannot withdraw
# cannot drain the account if it leaks. IP-restrict it to the machine that runs
# the collector.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Testnet by default. Set false ONLY when you intend to reach the real venue.
BYBIT_TESTNET=true

# Second, independent switch for anything that places an order. Both this and
# BYBIT_TESTNET=false are required to trade real money, so one mistaken edit
# cannot do it. Leave false until paper execution has been reconciled against
# the predicted-vs-realized ledger (/api/execution/calibration).
LIVE_TRADING_ENABLED=false

# ---------------------------------------------------------------- models
# Only the key matching GENERATION_LLM is needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Pass C2
# Declared but unset in config.py on purpose: the build must fail loudly rather
# than invent a value. Set them when C2 starts.
# GENERATION_LLM=gpt-5.6-luna-pro
# CANDIDATE_CAP_PER_CYCLE=          # protects the multiple-testing correction,
#                                   # not just cost -- there is no safe default
# GENERATION_CADENCE_S=
# DECAY_REPAIR_TRIGGER=sequential:min_trades=50,alpha=0.01
# LINEAGE_REPAIR_CAP=3

# ------------------------------------------------- LLM decoding profiles
# TWO profiles, deliberately not interchangeable. The generator explores inside
# the DSL's hard grammar; the scrutiny gate must give the same answer to the
# same setup, because consistency is its safety property. Never share a value
# between them, and never let a model response change one.
#
# GPT-5.5 is WIRED BUT NOT CALLED in this build. These slots exist so that
# enabling it later swaps one implementation rather than rewriting the plumbing.

# Generator -- exploration. Below 0.7 it converges on a few familiar templates
# that the diversity gate rejects, wasting trials; above 1.1 malformed-JSON
# rate climbs.
# GEN_TEMPERATURE=0.9
# GEN_TOP_P=0.95
# GEN_MAX_OUTPUT_TOKENS=2000        # too low truncates JSON: silent corruption
# GEN_SEED=                         # rotate per cycle; reuse kills diversity
# GEN_MAX_MONTHLY_USD=              # soft budget: breach pauses, never auto-adjusts

# Scrutiny -- consistency. A veto layer that answers differently to identical
# inputs is a second noise source wearing a safety badge.
# SCR_TEMPERATURE=0.1
# SCR_TOP_P=1.0
# SCR_MAX_OUTPUT_TOKENS=250
# SCR_SEED=7                        # fixed per prompt_version
# SCRUTINY_PROVIDER=rules           # `llm` is v2 and unreachable in this build
# SCRUTINY_LATENCY_BUDGET_MS=800    # timeout is a VETO, never a wait

# ------------------------------------------------------------- execution
# ORDER_ENTRY_STYLE=taker           # or maker_first_then_taker
# MAKER_TIMEOUT_MS=10000
# ARBITER_COOLDOWN_S=300
# TRADE_WINDOW_LOCAL=Africa/Nairobi:15:30-17:30
# AUTO_DEMOTE_COST_MULTIPLE=1.5
# AUTO_DEMOTE_LEG_WINDOW=10

# --------------------------------------------------------------- storage
# TWO STORES, both on Vultr. Postgres owns everything the system decides or
# commits plus the recent hot window; Parquet on Object Storage owns the
# immutable permanent record. There is no third store -- no Redis, no cache
# layer, no local JSON/CSV stand-in. MongoDB was cancelled permanently on
# 2026-08-06; reintroducing it needs a new master prompt, not a toggle.

# Postgres. On the VPS the data directory lives on the 256GB block volume
# (encrypted, separate from the VPS root) so rebuilding the instance does not
# take the decision record with it.
POSTGRES_DSN=postgresql://botmaximus:CHANGE_ME@127.0.0.1:5432/botmaximus

# Vultr Object Storage (S3-compatible), Tokyo primary + Singapore mirror.
# Leave OBJECTSTORE_ENDPOINT unset to use the local filesystem backend at
# ARCHIVE_LOCAL_ROOT -- adequate for one box, not durable.
OBJECTSTORE_ENDPOINT=
OBJECTSTORE_REGION=jp-tyo
OBJECTSTORE_ACCESS_KEY=
OBJECTSTORE_SECRET_KEY=
BUCKET_ARCHIVE=botmaximus-archive-tokyo
BUCKET_QUARANTINE=botmaximus-quarantine-tokyo
BUCKET_MIRROR=botmaximus-mirror-singapore
ARCHIVE_LOCAL_ROOT=data/archive

# Vultr host + the 256GB block volume
VULTR_REGION=nrt
VULTR_BLOCK_MOUNT=/mnt/blockstore

# ------------------------------------------------------------- TradeLoop
# The coordinator that walks a signal through Arbiter -> Scrutiny -> Risk ->
# Execute -> Ledger. OFF by default, and that is a correct state rather than a
# fault: until a strategy clears Gate 3 there is nothing in paper/micro/full to
# trade, so a running loop would faithfully do nothing.
#
# Enabling is `.env` + restart, deliberately never an HTTP endpoint — a route
# that can start trading is an attack surface. Every boot logs which state the
# loop is in and why, so its absence can never again be invisible.
#
# With this true, startup ABORTS unless require_trading() passes (Bybit
# credentials present; live_trading_enabled still False on testnet).
# TRADE_LOOP_ENABLED=false
#
# "<Area/City>:<HH:MM>-<HH:MM>". Unset enforces no window at the loop.
# TRADE_WINDOW_LOCAL=Africa/Nairobi:15:30-17:30

# ---------------------------------------------------------------- local
SYMBOL=BTCUSDT
API_PORT=8300
# staleness budgets (ms)
BUDGET_PRICE_TICK_MS=3000
BUDGET_OHLCV_1M_MS=75000
# quality gate
MAX_MINUTE_MOVE_PCT=5.0
